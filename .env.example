# ============================================================================
# Trade-Bot Environment Configuration (.env)
# Salin file ini menjadi `.env` (cp .env.example .env)
# File `.env` otomatis dimuat saat trade-bot dijalankan.
# ============================================================================

# 1. Kredensial Exchange Futures (Wajib untuk mode "testnet" atau "live", tidak perlu untuk "paper")
BINANCE_API_KEY=your_exchange_api_key_here
BINANCE_API_SECRET=your_exchange_api_secret_here

# 2. Kredensial AI / LLM Advisor & Asisten Tanya Jawab /query (Wajib jika "ai.enabled": true)
AI_API_KEY=your_openai_or_llm_api_key_here

# Custom System Prompt untuk asisten AI saat Anda bertanya lewat Telegram `/query <teks>` atau Desktop GUI:
AI_SYSTEM_PROMPT="Anda adalah Asisten AI Kuantitatif resmi di dalam aplikasi Trade-Bot. Jawablah setiap pertanyaan pengguna dalam Bahasa Indonesia yang ringkas, jelas, dan akurat berdasarkan data konfigurasi, saldo, posisi terbuka, riwayat transaksi, dokumen skills.md, serta log aktivitas terakhir dari bot."

# 3. Kredensial Bot Telegram Monitoring & Kontrol Interaktif (Wajib jika "telegram.enabled": true)
# Dapatkan token dari @BotFather dan angka Chat ID pribadi Anda dari @userinfobot.
# Untuk memakai bot di Chat Pribadi (DM) sekaligus di Grup Telegram, pisahkan dengan koma
# (Chat ID Grup diawali tanda minus, contoh: TELEGRAM_CHAT_ID=123456789,-100987654321)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTelegramBotTokenFromBotFather
TELEGRAM_CHAT_ID=123456789
# Opsional: ID User Telegram Owner (jika kosong, otomatis memakai ID positif pertama di TELEGRAM_CHAT_ID).
# Pesan Private (DM) dari selain Owner TIDAK akan dijawab oleh bot (silent ignore).
TELEGRAM_OWNER_ID=123456789

# 4. Level Logging Internal
RUST_LOG=info
